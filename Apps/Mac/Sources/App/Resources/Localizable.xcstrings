    "help.faq.install.q": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How are tools installed?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具怎么安装？"
          }
        }
      }
    },
    "help.faq.install.a": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each tool uses a typed Homebrew, mise, npm, or official-package action from the signed catalog. There is no remote shell."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个工具都使用签名目录里的 Homebrew、mise、npm 或官方包动作，没有远程 Shell。"
          }
        }
      }
    },
    "help.faq.update.q": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is the difference between app and tool updates?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用更新和工具更新有什么区别？"
          }
        }
      }
    },
    "help.faq.update.a": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App updates use Sparkle. Tool updates are confirmed per tool and never run brew upgrade globally."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用更新走 Sparkle。工具更新按单个工具确认，永远不会全局执行 brew upgrade。"
          }
        }
      }
    },
    "help.faq.sudo.q": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Will Coding Tools change my PATH?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会改我的 PATH 吗？"
          }
        }
      }
    },
    "help.faq.sudo.a": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No. It does not edit .zshrc or overwrite PATH, and it does not run sudo silently."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会。它不改 .zshrc、不覆盖 PATH，也不会静默 sudo。"
          }
        }
      }
    },
    "help.faq.privacy.q": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is included in diagnostics?"
