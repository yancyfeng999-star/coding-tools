    "settings.update.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine automatischen Updates. Nutzen Sie „Nach Updates suchen“ oben. Ist eine Version geladen, wählen Sie „Installieren und neu starten“. Alternativ den Installer von GitHub Releases laden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates never start by themselves. Use Check for Updates at the top of this section. If a version is already downloaded, use Install and Relaunch. You can also download the installer from GitHub Releases."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune mise à jour automatique. Cliquez sur Vérifier les mises à jour en haut. Si une version est déjà téléchargée, cliquez sur Installer et relancer. Vous pouvez aussi télécharger l’installateur depuis GitHub Releases."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動では更新しません。この欄の上の「更新を確認」を押してください。すでにダウンロード済みなら「インストールして再起動」を押します。GitHub Releases からインストーラを入手することもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동으로 업데이트하지 않습니다. 이 영역의 맨 위 ‘업데이트 확인’을 누르세요. 이미 다운로드된 버전이 있으면 ‘설치 후 다시 시작’을 누르세요. GitHub Releases에서 설치 파일을 받을 수도 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会自动检查更新。请点本区顶部的「检查更新」。若已下载完成，请点「安装并重启」。也可从 GitHub Releases 下载安装包。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay actualizaciones automáticas. Pulsa Comprobar actualizaciones arriba. Si ya se descargó una versión, pulsa Instalar y reiniciar. También puedes descargar el instalador desde GitHub Releases."
          }
        }
      }
    },
