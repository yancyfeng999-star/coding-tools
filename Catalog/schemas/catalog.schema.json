{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codingtools.example.com/schemas/catalog.schema.json",
  "title": "Coding Tools Catalog Snapshot",
  "description": "v1.0.0 草案。完整定义见 docs/CATALOG_SCHEMA.md。",
  "type": "object",
  "required": [
    "schemaVersion",
    "catalogVersion",
    "createdAt",
    "expiresAt",
    "keyID",
    "signature",
    "tools"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "catalogVersion": {
      "type": "string",
      "description": "目录自身的版本（日期 + 序号）"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "keyID": {
      "type": "string",
      "description": "Ed25519 公钥 ID（8 字节 hex）"
    },
    "signature": {
      "type": "string",
      "description": "base64 编码的 Ed25519 签名"
    },
    "tools": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/$defs/tool" }
    },
    "contentRefs": {
      "type": "array",
      "items": { "$ref": "#/$defs/contentRef" }
    },
    "revokedItems": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "required": [
        "id",
        "slug",
        "name",
        "localizedName",
        "description",
        "localizedDescription",
        "category",
        "homepageURL",
        "installOptions",
        "supportedArchitectures",
        "minimumMacOS",
        "status",
        "riskLevel"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "slug": { "type": "string" },
        "name": { "type": "string" },
        "localizedName": { "$ref": "#/$defs/localizedString" },
        "description": { "type": "string" },
        "localizedDescription": { "$ref": "#/$defs/localizedString" },
        "category": { "$ref": "#/$defs/category" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "homepageURL": { "type": "string", "format": "uri", "pattern": "^https://" },
        "documentationURL": { "type": "string", "format": "uri", "pattern": "^https://" },
        "installOptions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/installOption" }
        },
        "launchCapability": { "$ref": "#/$defs/launchCapability" },
        "supportedArchitectures": {
          "type": "array",
          "items": { "enum": ["arm64", "x86_64"] }
        },
        "minimumMacOS": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "status": { "enum": ["active", "deprecated", "experimental"] },
        "riskLevel": { "enum": ["low", "medium", "high"] }
      }
    },
    "installOption": {
      "type": "object",
      "required": ["type", "riskLevel"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "homebrew-formula",
            "homebrew-cask",
            "mise-tool",
            "official-artifact"
          ]
        },
        "packageName": { "type": "string" },
        "versionRule": { "type": "string" },
        "toolName": { "type": "string" },
        "version": { "type": "string" },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bundleID": { "type": "string" },
        "teamID": { "type": "string", "pattern": "^[A-Z0-9]{10}$" },
        "supportedArchitectures": {
          "type": "array",
          "items": { "enum": ["arm64", "x86_64"] }
        },
        "minimumMacOS": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "requiresAuthorization": { "type": "boolean" },
        "riskLevel": { "enum": ["low", "medium", "high"] }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "homebrew-formula" } } },
          "then": { "required": ["packageName"] }
        },
        {
          "if": { "properties": { "type": { "const": "homebrew-cask" } } },
          "then": { "required": ["packageName"] }
        },
        {
          "if": { "properties": { "type": { "const": "mise-tool" } } },
          "then": { "required": ["toolName"] }
        },
        {
          "if": { "properties": { "type": { "const": "official-artifact" } } },
          "then": { "required": ["url", "sha256"] }
        }
      ]
    },
    "launchCapability": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["cli", "app", "url", "none"] },
        "command": { "type": "string" },
        "arguments": { "type": "array", "items": { "type": "string" } },
        "openInTerminal": { "type": "boolean" },
        "bundleID": { "type": "string" },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "contentRef": {
      "type": "object",
      "required": ["contentID", "type", "url", "language"],
      "additionalProperties": false,
      "properties": {
        "contentID": { "type": "string" },
        "type": { "enum": ["article", "video", "docs", "rss"] },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "language": { "type": "string" }
      }
    },
    "category": {
      "enum": [
        "editor",
        "terminal",
        "git-collaboration",
        "node",
        "python",
        "go",
        "rust",
        "java",
        "database",
        "api-debug",
        "docker",
        "ai-coding",
        "frontend",
        "backend",
        "devops",
        "cli-utility",
        "language-runtime"
      ]
    },
    "localizedString": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
